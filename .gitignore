# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/playwright/

# next.js
/.next/
/out/

# production
/build
/production/video/output/**/*.mp4
/production/video/output/**/preview-*.png
/production/video/output/review-v2/
/production/video/output/concepts/review-v2/
/public/video-production/**/audio/
/public/video-production/**/audio-v2/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
