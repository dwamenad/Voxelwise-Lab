{
  "name": "fsl-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "video:studio": "remotion studio production/video/src/index.ts",
    "video:voices": "node production/video/scripts/generate-voice-auditions.mjs",
    "video:validate": "node production/video/scripts/validate-video-library.mjs",
    "video:validate:generated": "node production/video/scripts/validate-video-library.mjs --require-concept-generated --require-contrast-generated",
    "video:validate:masters": "node production/video/scripts/validate-video-library.mjs --require-concept-generated --require-contrast-generated --require-masters",
    "video:prepare:concepts": "node production/video/scripts/generate-concept-library.mjs && npm run video:validate && node production/video/scripts/generate-concept-narration.mjs && node production/video/scripts/validate-video-library.mjs --require-concept-generated",
    "video:render:concepts": "npm run video:prepare:concepts && node production/video/scripts/render-concept-batch.mjs",
    "video:render:concepts:prepared": "node production/video/scripts/render-concept-batch.mjs",
    "video:narrate:contrasts": "node production/video/scripts/generate-narration.mjs production/video/content/understanding-contrasts.json && node production/video/scripts/validate-video-library.mjs --require-contrast-generated",
    "video:prepare:v2": "npm run video:prepare:concepts && npm run video:narrate:contrasts && npm run video:validate:generated",
    "video:review:pilots": "node production/video/scripts/render-review-frames.mjs what-is-a-nifti-image what-is-a-glm introduction-to-fsleyes reviewing-complete-feat-report",
    "video:review:v2": "node production/video/scripts/render-review-frames.mjs",
    "video:render:pilots": "npm run video:prepare:v2 && node production/video/scripts/render-concept-batch.mjs what-is-a-nifti-image what-is-a-glm introduction-to-fsleyes reviewing-complete-feat-report",
    "video:render:contrasts": "npm run video:narrate:contrasts && remotion render production/video/src/index.ts UnderstandingContrasts production/video/output/understanding-contrasts-v2.mp4 --codec=h264 --crf=18 --concurrency=4 --overwrite",
    "video:render:v2": "npm run video:prepare:v2 && node production/video/scripts/render-concept-batch.mjs && remotion render production/video/src/index.ts UnderstandingContrasts production/video/output/understanding-contrasts-v2.mp4 --codec=h264 --crf=18 --concurrency=4 --overwrite && npm run video:validate:masters",
    "video:validate:walkthroughs": "node production/video/scripts/validate-live-walkthroughs.mjs",
    "video:validate:walkthroughs:generated": "node production/video/scripts/validate-live-walkthroughs.mjs --require-generated --require-assets",
    "video:validate:walkthroughs:masters": "node production/video/scripts/validate-live-walkthroughs.mjs --require-generated --require-assets --require-masters",
    "video:validate:release": "node production/video/scripts/validate-video-release.mjs",
    "video:validate:release:publishable": "node production/video/scripts/validate-video-release.mjs --require-publishable",
    "video:validate:release:published": "node production/video/scripts/validate-video-release.mjs --require-published",
    "video:record-review": "node production/video/scripts/record-video-review.mjs",
    "video:layout:walkthrough": "node production/video/scripts/prepare-live-walkthrough.mjs --print-layout",
    "video:package:walkthroughs": "node production/video/scripts/create-live-walkthrough-capture-packages.mjs",
    "video:validate:walkthrough-packages": "node production/video/scripts/create-live-walkthrough-capture-packages.mjs --check",
    "video:prepare:walkthrough": "node production/video/scripts/prepare-live-walkthrough.mjs",
    "video:render:walkthrough": "node production/video/scripts/render-live-walkthroughs.mjs",
    "video:render:walkthroughs": "node production/video/scripts/render-live-walkthroughs.mjs",
    "video:validate:pilot-audio": "node production/video/scripts/validate-video-audio.mjs production/video/output/walkthroughs/opening-feat/opening-feat-review.mp4 production/video/output/walkthroughs/opening-feat/opening-feat.srt production/narration/opening-feat.md",
    "video:prepare:opening-feat": "node production/video/scripts/prepare-opening-feat-pilot.mjs",
    "video:render:opening-feat": "npm run video:prepare:opening-feat && node production/video/scripts/render-live-walkthroughs.mjs opening-feat --review-only",
    "video:render:opening-feat:raw": "npm run video:prepare:opening-feat && node production/video/scripts/render-live-walkthroughs.mjs opening-feat --raw-only"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.507",
    "@remotion/media-utils": "^4.0.507",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "remotion": "^4.0.507",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
