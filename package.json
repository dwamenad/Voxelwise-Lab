{
  "name": "fsl-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "video:studio": "remotion studio production/video/src/index.ts",
    "video:voices": "node production/video/scripts/generate-voice-auditions.mjs",
    "video:validate": "node production/video/scripts/validate-video-library.mjs",
    "video:validate:generated": "node production/video/scripts/validate-video-library.mjs --require-concept-generated --require-contrast-generated",
    "video:validate:masters": "node production/video/scripts/validate-video-library.mjs --require-concept-generated --require-contrast-generated --require-masters",
    "video:prepare:concepts": "node production/video/scripts/generate-concept-library.mjs && npm run video:validate && node production/video/scripts/generate-concept-narration.mjs && node production/video/scripts/validate-video-library.mjs --require-concept-generated",
    "video:render:concepts": "npm run video:prepare:concepts && node production/video/scripts/render-concept-batch.mjs",
    "video:render:concepts:prepared": "node production/video/scripts/render-concept-batch.mjs",
    "video:narrate:contrasts": "node production/video/scripts/generate-narration.mjs production/video/content/understanding-contrasts.json && node production/video/scripts/validate-video-library.mjs --require-contrast-generated",
    "video:prepare:v3": "npm run video:voices && npm run video:prepare:concepts && npm run video:narrate:contrasts && npm run video:validate:generated",
    "video:review:pilots": "node production/video/scripts/render-review-frames.mjs what-is-a-nifti-image what-is-a-glm introduction-to-fsleyes reviewing-complete-feat-report",
    "video:review:v2": "node production/video/scripts/render-review-frames.mjs",
    "video:render:pilots": "npm run video:prepare:v3 && node production/video/scripts/render-concept-batch.mjs what-is-a-nifti-image what-is-a-glm introduction-to-fsleyes reviewing-complete-feat-report",
    "video:render:contrasts": "npm run video:narrate:contrasts && node production/video/scripts/render-voice-variants.mjs contrasts",
    "video:render:v3": "npm run video:prepare:v3 && node production/video/scripts/render-concept-batch.mjs && node production/video/scripts/render-voice-variants.mjs contrasts && npm run video:validate:masters",
    "video:prepare:opening-feat": "node production/video/scripts/prepare-opening-feat-pilot.mjs",
    "video:render:opening-feat": "npm run video:prepare:opening-feat && node production/video/scripts/render-voice-variants.mjs opening-feat",
    "video:render:opening-feat:raw": "npm run video:prepare:opening-feat && remotion render production/video/src/index.ts OpeningFeatRaw production/video/output/walkthroughs/opening-feat/opening-feat-raw.mp4 --codec=h264 --crf=18 --concurrency=4 --overwrite"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.507",
    "@remotion/media-utils": "^4.0.507",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "remotion": "^4.0.507",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
