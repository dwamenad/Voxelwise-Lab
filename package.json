{
  "name": "fsl-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "video:studio": "remotion studio production/video/src/index.ts",
    "video:voices": "node production/video/scripts/generate-voice-auditions.mjs",
    "video:prepare:concepts": "node production/video/scripts/generate-concept-library.mjs && node production/video/scripts/generate-concept-narration.mjs",
    "video:render:concepts": "npm run video:prepare:concepts && node production/video/scripts/render-concept-batch.mjs",
    "video:render:concepts:prepared": "node production/video/scripts/render-concept-batch.mjs",
    "video:narrate:contrasts": "node production/video/scripts/generate-narration.mjs production/video/content/understanding-contrasts.json",
    "video:render:contrasts": "npm run video:narrate:contrasts && remotion render production/video/src/index.ts UnderstandingContrasts production/video/output/understanding-contrasts.mp4 --codec=h264 --crf=18 --concurrency=4"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.507",
    "@remotion/media-utils": "^4.0.507",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "remotion": "^4.0.507",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
